# ==============================================================================
# DCA++ GPU Solver — CUDA-accelerated CT-AUX for cluster DMFT
#
# Used when TRIQS/CTHYB sign problem kills N_c=4 calculations at low T.
# CT-AUX algorithm has better sign properties for the Hubbard model.
#
# Build:
#   docker build -t qae-dcaplus:latest -f dmft/Dockerfile.dcaplus .
#
# Run:
#   docker run --rm --gpus=device=0 -v /data/dcaplus:/data/dcaplus \
#     qae-dcaplus:latest main_dca --input_file=/data/dcaplus/input.json
# ==============================================================================

FROM nvidia/cuda:12.4.0-devel-ubuntu22.04 AS builder

RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
      build-essential cmake git wget \
      libhdf5-dev libfftw3-dev \
      openmpi-bin libopenmpi-dev \
      python3-dev python3-pip \
      libblas-dev liblapack-dev \
    && rm -rf /var/lib/apt/lists/*

# Build DCA++ from source
RUN cd /opt && \
    git clone --depth 1 https://github.com/CompFUSE/DCA.git && \
    cd DCA && \
    mkdir build && cd build && \
    cmake .. \
      -DCMAKE_BUILD_TYPE=Release \
      -DDCA_WITH_CUDA=ON \
      -DDCA_WITH_MPI=ON \
      -DDCA_LATTICE=square \
      -DDCA_POINT_GROUP=D4 \
      -DDCA_MODEL=tight-binding \
      -DDCA_RNG=std::mt19937_64 \
      -DDCA_PROFILER=None \
    && make -j$(nproc) main_dca 2>&1 | tail -20

FROM nvidia/cuda:12.4.0-runtime-ubuntu22.04

RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
      libhdf5-103 libfftw3-3 \
      openmpi-bin libopenmpi3 \
      python3 python3-pip \
      libblas3 liblapack3 \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir h5py numpy

COPY --from=builder /opt/DCA/build/applications/dca/main_dca /usr/local/bin/main_dca

RUN mkdir -p /data/dcaplus

ENV OMPI_ALLOW_RUN_AS_ROOT=1
ENV OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1

WORKDIR /data/dcaplus
ENTRYPOINT ["/usr/local/bin/main_dca"]
